  "id": "logic-005",
  "title": "条件付き推論（前件肯定）",
  "content": "「もしPならばQ」が真で、かつPが真であるとき、Qが真であると推論できる。これは前件肯定（モーダス・ポネンス）と呼ばれる論理的に妥当な推論形式である。",
  "facts": [
    {
      "id": "fact_logic005_condition",
      "keywords": ["条件付き命題", "前件肯定", "モーダス・ポネンス"],
      "value": true
    }
  ],
  "rules": [
    {
      "id": "rule-logic-005-1",
      "if": {
        "fact": "fact_logic005_condition"
      },
      "then": {
        "fact": "fact_logic005_result",
        "value": true
      },
      "explanation": "条件付き命題と前件の真偽から後件の真偽を導く推論形式が妥当であるため"
    }
  ]
}
