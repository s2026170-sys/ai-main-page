      "id": "logic-001",
      "title": "雨と傘の関係",
      "content": "雨が降っていて傘を持っていない場合、濡れる可能性が高い。",
      "facts": [
        {
          "id": "rain",
          "keywords": ["雨が降っている", "雨", "降雨"],
          "value": true
        },
        {
          "id": "umbrella",
          "keywords": ["傘を持っている", "傘がある"],
          "value": true
        },
        {
          "id": "wet",
          "keywords": ["濡れる", "服が濡れる"],
          "value": true
        }
      ],
      "rules": [
        {
          "id": "rule-rain-001",
          "if": {
            "all": [
              { "fact": "rain" },
              { "not": { "fact": "umbrella" } }
            ]
          },
          "then": {
            "fact": "wet",
            "value": true
          },
          "explanation": "雨が降っていて傘を持っていないため、濡れる可能性が高いと判断しました。"
        }
      ]
    },
